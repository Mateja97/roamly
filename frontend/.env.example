VITE_PROXY_URL=http://localhost:8080
# Admin panel (T2): sent as the X-Admin-Token header on every /admin/* call.
# Must match proxy-service's ADMIN_API_TOKEN. See
# backend/proxy-service/README.md's "Admin authentication" section for why
# this is a low bar (not real per-user auth), and by design.
VITE_ADMIN_TOKEN=
