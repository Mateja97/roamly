VITE_PROXY_URL=http://localhost:8080
# Admin panel (T2): sent as the X-Admin-Token header on every /admin/* call.
# Must match proxy-service's ADMIN_API_TOKEN. See
# backend/proxy-service/README.md's "Admin authentication" section for why
# this is a low bar (not real per-user auth), and by design.
VITE_ADMIN_TOKEN=
# T4: Google Static Maps API key (Maps Static API enabled), for the Edit
# activity screen's read-only location preview. Same Google Maps Platform
# key precedent as app/src/api/staticMap.ts. Optional — when unset, the
# static map image request 404s and the preview falls back to its broken-
# image state (no separate "no key" state needed).
VITE_GOOGLE_MAPS_API_KEY=
